RECIPE_API_PROVIDER=mock
RECIPE_API_KEY=
RECIPE_API_BASE_URL=

# Free Recipe Pricing uses TheMealDB (no key / no billing):
# https://www.themealdb.com/api/json/v1/1/search.php?s={term}
# Do not point this feature at paid recipe APIs.

# mock | live | auto (auto uses live keys when present, else mock)
PRICE_PROVIDER_MODE=auto

# Google Maps (Places Nearby + Geocoding) — official
# Places type=supermarket / grocery_store for nearby Coles, Woolworths, ALDI, IGA
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Australia Post PAC (optional suburb/postcode validation) — official
AUSPOST_API_KEY=

# Shared RapidAPI key (feeds Woolworths + Coles if store-specific keys are empty)
RAPIDAPI_KEY=
THIRD_PARTY_GROCERY_API_KEY=

# Woolworths via RapidAPI — unofficial third-party
# Docs: https://rapidapi.com/data-holdings-group-data-holdings-group-default/api/woolworths-products-api
WOOLWORTHS_API_KEY=
WOOLWORTHS_API_BASE_URL=https://woolworths-products-api.p.rapidapi.com
WOOLWORTHS_API_HOST=woolworths-products-api.p.rapidapi.com

# Coles via RapidAPI — unofficial third-party
# Docs: https://rapidapi.com/data-holdings-group-data-holdings-group-default/api/coles-product-price-api
COLES_API_KEY=
COLES_API_BASE_URL=https://coles-product-price-api.p.rapidapi.com
COLES_API_HOST=coles-product-price-api.p.rapidapi.com
# Optional Coles BFF store id for direct search (defaults to a common AU store)
COLES_STORE_ID=0584

# Optional timeouts (ms) — keep price search snappy when stores block requests
GROCERY_DIRECT_TIMEOUT_MS=4500
GROCERY_RAPIDAPI_TIMEOUT_MS=6000
GROCERY_APIFY_TIMEOUT_MS=8000

# ALDI via Apify dataset and/or Actor — unofficial
# Docs: https://docs.apify.com/academy/api/run-actor-and-retrieve-data-via-api
# Preferred: dataset items from a completed Actor run
APIFY_API_TOKEN=
APIFY_DATASET_ID=
# Optional full items URL (if set, used instead of building from dataset id)
# Example: https://api.apify.com/v2/datasets/<DATASET_ID>/items?token=<TOKEN>
ALDI_CACHE_URL=
APIFY_ACTOR_ID=solidcode/aldi-com-au-scraper


# IGA weekly cached JSON catalogue — unofficial (no public API)
IGA_CACHE_URL=

# Open Food Facts — official open data (barcode / metadata / images)
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=MealPrepPro/1.0 (grocery comparison)

MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
